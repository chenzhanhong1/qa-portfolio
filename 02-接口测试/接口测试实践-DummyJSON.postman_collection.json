                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "新增商品",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/add",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"测试商品\", \"price\": 99, \"category\": \"test\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码属于 200, 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('标题回显正确', function () {",
                  "    pm.expect(pm.response.json().title).to.eql('测试商品');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "更新商品",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/1",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"更新后的商品\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('标题已更新', function () {",
                  "    pm.expect(pm.response.json().title).to.eql('更新后的商品');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "删除商品",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('isDeleted 为 true', function () {",
                  "    pm.expect(pm.response.json().isDeleted).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
