{
  "info": {
    "name": "接口测试实践-DummyJSON",
    "description": "软件测试实习作品：16 个请求，覆盖认证、商品、用户、购物车、异常场景；含状态码/字段/数组长度/响应时间断言，登录后自动保存 token。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1-认证",
      "item": [
        {
          "name": "登录-正确",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"emilys\", \"password\": \"emilyspass\", \"expiresInMins\": 30}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 accessToken', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('accessToken');",
                  "    pm.collectionVariables.set('token', body.accessToken);",
                  "});",
                  "pm.test('响应时间 < 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "登录-密码错误",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"emilys\", \"password\": \"wrong-password\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('返回错误信息', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "获取当前用户-带Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('用户名正确', function () {",
                  "    pm.expect(pm.response.json().username).to.eql('emilys');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2-商品",
      "item": [
        {
          "name": "商品列表-分页",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?limit=5&skip=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 5 条商品', function () {",
                  "    pm.expect(pm.response.json().products).to.be.an('array').with.lengthOf(5);",
                  "});",
                  "pm.test('商品字段完整', function () {",
                  "    const p = pm.response.json().products[0];",
                  "    pm.expect(p).to.have.property('id');",
                  "    pm.expect(p).to.have.property('title');",
                  "    pm.expect(p.price).to.be.a('number');",
                  "});",
                  "pm.test('响应时间 < 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "商品详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ID 为 1', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(1);",
                  "});",
                  "pm.test('标题为字符串', function () {",
                  "    pm.expect(pm.response.json().title).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "商品不存在-404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
